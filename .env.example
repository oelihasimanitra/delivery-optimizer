# Copiez ce fichier en .env puis remplissez-le. Ne le versionnez JAMAIS.
DELIVERYOPT_ADMIN_USER=admin
DELIVERYOPT_ADMIN_PASSWORD=changez-moi-au-moins-8-caracteres
# 1 si l'application est servie en HTTPS (recommandé hors réseau local)
DELIVERYOPT_SECURE_COOKIE=0
# Service public Nominatim (1 requête/s, usage modéré) : indiquez un contact réel. Laissez vide pour désactiver le géocodage.
DELIVERYOPT_NOMINATIM_URL=https://nominatim.openstreetmap.org
DELIVERYOPT_USER_AGENT=deliveryopt (votre-email@exemple.mg)
